[Unit]
Description=Helmetd %i camera uplink
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/.config/helmetd/cameras/%i.env
ExecStart=/usr/bin/python3 %h/helmetd/apps/capture/capture.py --source usb --device ${HELMETD_CAMERA_DEVICE} --usb-format mjpeg --width 640 --height 360 --fps ${HELMETD_CAMERA_FPS} --bitrate ${HELMETD_CAMERA_BITRATE} --host ${HELMETD_MAC_HOST} --port ${HELMETD_CAMERA_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
