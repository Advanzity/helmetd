# Copy to .env at the repository root. Never commit real credentials.
# Choose one: openai, google, anthropic. Only that provider needs a key/model.
HELMETD_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
HELMETD_LLM_MAX_TOKENS=512
HELMETD_LLM_TIMEOUT_SECONDS=60

# Generate with: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
# This token authenticates ElevenLabs to Helmetd; it is not a provider API key.
HELMETD_GATEWAY_TOKEN=

# Private ElevenLabs agent: hosted mode or the optional Custom LLM endpoint.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Standalone alerts use this voice/model; live conversation uses the agent's voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=

# Optional comma-separated public keys for the trusted-rider hazard feed.
# Without this, the local devnet wallet's reports are used.
HELMETD_TRUSTED_RIDERS=
